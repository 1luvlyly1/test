INS.forEach(i=>{i.score=Math.round(i.sev/4*65+i.conf*35);});
const TOP=[...INS].sort((a,b)=>(a.opp?1:0)-(b.opp?1:0)||b.sev-a.sev||b.score-a.score);
TOP.forEach((x,i)=>x.rank=i+1);
const SEVN=["","Thấp","Trung bình","Cao","Nghiêm trọng"];
const sevName=x=>x.opp?"Cơ hội":SEVN[x.sev];
const sevCls=x=>x.opp?"op":"s"+x.sev;
const sevTag=x=>`<span class="tag ${sevCls(x)}">${sevName(x)}</span>`;
const recOf=x=>x.sev>=3?"dl":(x.sev===2||x.opp)?"watch":"skip";
const REC={dl:"Đồng ý tải tin (.md)",watch:"Theo dõi",skip:"Bỏ qua"};

const OI={runId:0,done:false,dec:{},pick:{},note:{},sent:false,files:[]};
