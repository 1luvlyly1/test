    l.setUint32(0,0x04034b50,true);l.setUint16(4,20,true);l.setUint16(6,0x0800,true);l.setUint16(8,0,true);l.setUint16(10,dt,true);l.setUint16(12,dd,true);
    l.setUint32(14,crc,true);l.setUint32(18,data.length,true);l.setUint32(22,data.length,true);l.setUint16(26,nm.length,true);l.setUint16(28,0,true);
    parts.push(new Uint8Array(l.buffer),nm,data);
    const c=new DataView(new ArrayBuffer(46));
