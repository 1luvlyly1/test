const oiGuard=my=>{if(my!==OI.runId)throw "abort";};

function oiReset(){
  OI.runId++;OI.done=false;OI.dec={};OI.pick={};OI.note={};OI.sent=false;OI.files=[];
  renderAgents($("#oiAgents"),OIAG,"oa");$("#oiTerm").innerHTML="";
  $("#oiFeed").innerHTML='<div class="empty">Bấm <b>▶ Chạy phiên crawl đêm</b> để bắt đầu.</div>';
  $("#oiCount").textContent="(0)";$("#oiEvent").classList.remove("on");
  $("#oiBrief").innerHTML='<div class="empty">Chưa có bản tin. Chạy phiên crawl ở tab 1; Briefing Agent gửi bản tin lúc 06:30.</div>';
  $("#oiDl").innerHTML='<div class="card"><div class="empty">Chưa có tin nào được duyệt. Line Manager chọn "Đồng ý tải tin" ở tab 2 rồi bấm gửi quyết định.</div></div>';
  ["#oiB2","#oiB3"].forEach(b=>$(b).classList.add("hidden"));setClock($("#oiClock"),"22:00");$("#oiRun").disabled=false;
}
function feedItem(h){
  const d=document.createElement("div");d.className="item";d.id="f-"+h.id;
  d.innerHTML=`<div class="t">${h.t}</div><div><div class="ttl">${esc(h.title)}</div><div class="chips"><span class="chip src">${SRC[h.s].n} · ${SRC[h.s].r}</span><span class="chip st">mới</span></div></div>`;
  return d;
}
const setSt=(h,html)=>{$(`#f-${h.id} .st`).outerHTML=html;};
function applyHide(){const on=$("#oiHide").checked;$$("#oiFeed .item.out").forEach(e=>e.classList.toggle("hide",on));}

async function oiRun(){
  oiReset();const my=OI.runId;$("#oiRun").disabled=true;
  try{
    // 1. Crawl
    setAg("oa","crawl","run");$("#oiFeed").innerHTML="";
    oiLog("crawl","Khởi động phiên 22:00. Nguồn: 10 (6 quốc tế, 4 trong nước). Chế độ: chỉ lấy tiêu đề + URL + giờ đăng.");
    await sleep(500);oiGuard(my);
