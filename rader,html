  checks:["Xác nhận các khoản tất toán của Top 5 KH tại CN A, CN B: chứng từ, nguồn tiền","Kiểm tra có chiến lược/chương trình nào: bán nợ, chuyển nợ, xử lý nợ, tái cấu trúc khoản vay","Rà soát nhóm 3 KH liên quan tất toán đồng loạt 16:42–16:58: nguồn tiền từ đâu?","Theo dõi đề nghị giải ngân lại cho cùng nhóm KH trong ngày T và T+1 (dấu hiệu đảo nợ, làm đẹp số liệu)","Kiểm tra user thực hiện, cấp phê duyệt và thẩm quyền của các giao dịch"]}
];
const DOWNSTREAM=["Báo cáo quản trị điều hành 08:00 (MIS)","Mô hình cảnh báo sớm rủi ro tín dụng (EWS)","Dashboard tăng trưởng tín dụng theo chi nhánh","Báo cáo chỉ số thanh khoản nội bộ (LDR)"];
const OUT={
 tech:{btn:"Kỹ thuật: lỗi nạp dữ liệu",t:["done","Xác nhận lỗi · đã chạy lại job"],b:["closed","Đóng tự động: số liệu không phản ánh giao dịch thật"],
  find:"Bản deploy 21:40 làm sai điều kiện join, nên lần retry lúc 04:51 chỉ nạp 2/3 partition từ LOS doanh nghiệp. Các khoản vay lớn của 5 KH bị rơi khỏi snapshot, còn bản ghi thu nợ bị ghi trùng khi retry.",
  act:["Rollback bản deploy và chạy lại job: dư nợ T-1 = 438.750 tỷ (−0,04% so với T-2), trở về bình thường","Gỡ cách ly feature; các báo cáo downstream chạy lại lúc 08:40","Lập biên bản sự cố dữ liệu theo quy trình quản trị dữ liệu"],
  learn:"Bổ sung kiểm tra tự động \"số bản ghi theo partition\" trước khi công bố feature; không deploy pipeline sau 21:00 ngày làm việc.",q:false},
 biz:{btn:"Kinh doanh: biến động hợp lệ",t:["done","Hệ thống ổn định · dữ liệu khớp GL"],b:["done","Xác nhận hợp lệ"],
  find:"Dữ liệu đúng và khớp sổ cái GL. 2 KH lớn tại CN A, CN B tất toán trước hạn bằng tiền bán tài sản, có đủ chứng từ. Nhóm 3 KH liên quan tất toán theo phương án tái cấu trúc đã được Hội đồng tín dụng phê duyệt. Job chạy chậm do khối lượng giao dịch lớn.",
  act:["Gỡ cách ly feature, ghi nhận ngoại lệ có giải trình","Cập nhật dự báo dư nợ và tiến độ chỉ tiêu tăng trưởng tín dụng quý","RM tìm cơ hội tái giải ngân cho KH có nhu cầu"],
  learn:"Gắn nhãn \"biến động hợp lệ – tất toán lớn có kế hoạch\". Đề xuất khối kinh doanh báo trước các giao dịch tất toán trên 1.000 tỷ để agent không cảnh báo nhầm.",q:false},
 fraud:{btn:"Dấu hiệu gian lận / bất thường",t:["done","Hệ thống ổn định · dữ liệu khớp GL"],b:["esc","Chuyển Kiểm soát nội bộ & Pháp chế"],
  find:"Hệ thống ổn định, dữ liệu khớp sổ cái GL. Tuy nhiên tiền tất toán của nhóm 3 KH liên quan đến từ các khoản vay mới tại một TCTD khác, giải ngân cùng ngày. Sáng ngày T đã có hồ sơ đề nghị giải ngân lại cho cùng nhóm với hạn mức cao hơn. Đây là dấu hiệu đảo nợ / che giấu nợ có vấn đề.",
  act:["Tạm dừng xử lý hồ sơ giải ngân mới cho nhóm KH liên quan","Chuyển hồ sơ cho Kiểm soát nội bộ và Pháp chế; rà soát RM và cấp phê duyệt","Giữ cách ly feature cho mô hình EWS đến khi có kết luận; báo cáo theo quy định nội bộ"],
  learn:"Thêm quy tắc phát hiện: \"tất toán lớn sát giờ chốt + nhóm KH liên quan + đề nghị giải ngân lại trong 48 giờ\".",q:true}
};
const fmtN=n=>n.toLocaleString("vi-VN");
const tkId=t=>`${t.code}-${ymd(1).slice(2)}-${t.k==="tech"?"01":"02"}`;
const IO={runId:0,done:false,outcome:null};
const ioLog=mkLog($("#ioTerm"),$("#ioClock"));
const IOAG=[
 {id:"etl",n:"Theo dõi batch ETL đêm",d:"Trạng thái job, thời gian chạy, retry"},
 {id:"dq",n:"Giám sát feature",d:"So T-1 với T-2, T-7 và dải bình thường"},
 {id:"rca",n:"Phân rã nguyên nhân",d:"Theo phân khúc, chi nhánh, khách hàng"},
 {id:"route",n:"Định tuyến cảnh báo",d:"Gửi phiếu cho Kỹ thuật & Kinh doanh, cách ly feature"}
];
const ioGuard=my=>{if(my!==IO.runId)throw "abort";};

function ioChart(w=620,h=200){
  const s=SERIES,P={l:58,r:96,t:14,b:26},mn=405000,mx=446000;
  const X=i=>P.l+i*(w-P.l-P.r)/(s.length-1),Y=v=>P.t+(mx-v)/(mx-mn)*(h-P.t-P.b);
  const base=s.slice(0,13).reduce((a,b)=>a+b,0)/13;
  const grid=[410000,420000,430000,440000].map(v=>`<line class="gl" x1="${P.l}" x2="${w-P.r}" y1="${Y(v)}" y2="${Y(v)}"/><text class="ax" x="${P.l-6}" y="${Y(v)+3}" text-anchor="end">${fmtN(v)}</text>`).join("");
  const xl=s.map((_,i)=>{const k=14-i;return (k%2===1||k===2)?`<text class="ax" x="${X(i)}" y="${h-8}" text-anchor="middle">T-${k}</text>`:"";}).join("");
  const path=s.slice(0,13).map((v,i)=>`${i?"L":"M"}${X(i)},${Y(v)}`).join("");
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Dư nợ chốt ngày T-14 đến T-1, T-1 giảm 6,06%">
    <rect class="band" x="${P.l}" width="${w-P.l-P.r}" y="${Y(base*1.015)}" height="${Y(base*0.985)-Y(base*1.015)}"/>
    <text class="bl" x="${P.l+4}" y="${Y(base*1.015)+11}">Dải bình thường ±1,5%</text>
    ${grid}${xl}<path class="ln" d="${path}"/><path class="ln2" d="M${X(12)},${Y(s[12])}L${X(13)},${Y(s[13])}"/>
    ${s.slice(0,13).map((v,i)=>`<circle class="pt" cx="${X(i)}" cy="${Y(v)}" r="${i===12||i===7?4:2.5}"/>`).join("")}
    <circle class="bad" cx="${X(13)}" cy="${Y(s[13])}" r="5"/>
    <text class="lbl" x="${X(13)+8}" y="${Y(s[13])+4}">T-1: ${fmtN(s[13])}</text>
    <text class="lbl" x="${X(13)+8}" y="${Y(s[13])+18}">−6,06% vs T-2</text>
    <text class="ax" x="${X(12)+6}" y="${Y(s[12])-8}">T-2: ${fmtN(s[12])}</text>
    <text class="ax" x="${X(7)}" y="${Y(s[7])-9}" text-anchor="middle">T-7: ${fmtN(s[7])}</text>
    <text class="ax" x="${P.l}" y="${P.t-3}">tỷ đồng</text></svg>`;
}
const stTxt=st=>st==="ok"?"Bình thường":st==="warn"?"Cảnh báo nhẹ":"Bất thường";
const featRow=f=>`<tr><td>${f.n}<br><code>${f.f}</code></td><td>${f.t1}</td><td>${f.t2}</td><td>${f.t7}</td><td>${f.d}</td><td class="st-${f.st}">${stTxt(f.st)}</td></tr>`;

function ioReset(){
  IO.runId++;IO.done=false;IO.outcome=null;
  renderAgents($("#ioAgents"),IOAG,"ia");$("#ioTerm").innerHTML="";$("#ioRows").innerHTML="";
  $("#ioChartBox").classList.add("hidden");$("#ioEmpty").classList.remove("hidden");$("#ioB2").classList.add("hidden");
  $("#ioArea").innerHTML='<div class="empty">Chưa có cảnh báo. Chạy kiểm tra dữ liệu ở tab 1.</div>';
  setClock($("#ioClock"),"03:30");$("#ioRun").disabled=false;
}
async function ioRun(){
  ioReset();const my=IO.runId;$("#ioRun").disabled=true;$("#ioEmpty").classList.add("hidden");
  try{
    setAg("ia","etl","run");
    ioLog("etl","Batch ETL đêm bắt đầu: 14 job, nguồn Core Banking, LOS, Thẻ, TTQT, Huy động.");await sleep(500);ioGuard(my);
    for(const [t,m] of [["03:38","Job snapshot huy động: hoàn tất (OK)"],["03:52","Job giao dịch thẻ: hoàn tất (OK)"],["04:05","Job TTQT: hoàn tất (OK)"]]){setClock($("#ioClock"),t);ioLog("etl",m,"m");await sleep(350);ioGuard(my);}
    setClock($("#ioClock"),"04:51");ioLog("etl","Job snapshot dư nợ: timeout khi đọc LOS doanh nghiệp → retry lần 1","w");await sleep(600);ioGuard(my);
    setClock($("#ioClock"),"05:27");ioLog("etl","Job snapshot dư nợ hoàn tất, chậm 1h49 so với trung bình (03:38).","w");
    setAg("ia","etl","done","14/14 job · 1 retry");await sleep(400);ioGuard(my);

    setAg("ia","dq","run");setClock($("#ioClock"),"05:30");
    ioLog("dq","Kiểm tra 9 feature của số liệu chốt ngày T-1: so với T-2, T-7 và dải biến động ±1,5%/ngày…");await sleep(500);ioGuard(my);
    for(const [i,f] of FEATS.entries()){
      $("#ioRows").insertAdjacentHTML("beforeend",featRow(f));
      ioLog("dq",`${f.f}: T-1 ${f.t1} · T-2 ${f.t2} · T-7 ${f.t7} · ${f.d} → ${stTxt(f.st).toUpperCase()}`,f.st==="alert"?"e":f.st==="warn"?"w":"m");
      if(i===0){$("#ioChartBox").innerHTML=ioChart(620,190);$("#ioChartBox").classList.remove("hidden");}
      await sleep(f.st==="ok"?180:360);ioGuard(my);
    }
    ioLog("dq","Kiểm tra chéo: giải ngân 2.330 − thu nợ 28.940 = −26.610 tỷ, khớp mức giảm dư nợ.","m");
    setAg("ia","dq","done","3 bất thường · 2 cảnh báo nhẹ");

    setAg("ia","rca","run");setClock($("#ioClock"),"05:38");
    ioLog("rca","Phân rã mức giảm −26.610 tỷ…");await sleep(500);ioGuard(my);
    ioLog("rca","Theo phân khúc: KHDN −25.980 (97,6%), KHCN −630 (2,4%).");await sleep(350);ioGuard(my);
    ioLog("rca","Theo chi nhánh: CN A −14.210 (53%), CN B −9.870 (37%), 46 CN còn lại −2.530.");await sleep(350);ioGuard(my);
    ioLog("rca","Theo khách hàng: Top 5 KH chiếm 81%; 3/5 KH có cùng người đại diện pháp luật.","w");await sleep(350);ioGuard(my);
    ioLog("rca","Tín hiệu kỹ thuật: retry, chậm 1h49, thiếu ~770 bản ghi LOS doanh nghiệp, deploy pipeline 21:40.","w");await sleep(300);ioGuard(my);
    ioLog("rca","Tín hiệu kinh doanh: thu nợ ×15, tất toán 16:42–16:58 sát giờ chốt, tập trung nhóm KH liên quan.","w");await sleep(300);ioGuard(my);
    ioLog("rca","Kết luận: có tín hiệu từ cả hai phía, chưa đủ cơ sở kết luận → cần kiểm tra song song.","e");
    setAg("ia","rca","done","Tín hiệu từ 2 phía");

    setAg("ia","route","run");setClock($("#ioClock"),"05:45");await sleep(500);ioGuard(my);
    TK.forEach(t=>ioLog("route",`Đã gửi ${tkId(t)} → ${t.team} (${t.pri}, ${t.sla.toLowerCase()})`,"ok"));
    ioLog("route",`Cách ly feature du_no_chot_ngay: ${DOWNSTREAM.length} hệ thống phía sau tạm dùng số T-2 kèm cờ cảnh báo.`,"w");
    setAg("ia","route","done","2 phiếu · 1 feature cách ly");
    IO.done=true;renderIO();$("#ioB2").classList.remove("hidden");
    toast(`<b>05:45 · Cảnh báo Inside-Out</b><br>Dư nợ chốt T-1 giảm 6,06%. Đã gửi phiếu cho Kỹ thuật (P1) và Kinh doanh & Kiểm soát.`);
  }catch(e){if(e!=="abort")console.error(e);}
  $("#ioRun").disabled=false;
}
function renderIO(){
  const o=IO.outcome?OUT[IO.outcome]:null,tkst=t=>o?(t.k==="tech"?o.t:o.b):["","Đã gửi 05:45 · chờ phản hồi"],qu=!o||o.q;
  const tbl=(rows,h)=>`<table class="fchk"><thead><tr><th>${h}</th><th>Mức giảm (tỷ)</th><th>Tỷ trọng</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td></tr>`).join("")}</tbody></table>`;
  $("#ioArea").innerHTML=`
  <div class="brief-head">
    <div><h2>Cảnh báo Inside-Out · Dữ liệu chốt ngày ${dLabel(0)} (T-1)</h2>
    <div class="meta">Phát hiện 05:30 · Định tuyến 05:45 · Nguồn: kho dữ liệu nội bộ sau batch ETL đêm</div></div>
    <span class="alert" style="background:var(--vio-soft);color:var(--vio)">Bất thường dữ liệu · kiểm tra song song</span>
  </div>
  <div class="iosec"><h5>Feature dư nợ cho vay chốt ngày (14 ngày gần nhất)</h5>${ioChart()}
    <p class="note" style="margin:6px 0 0">T-1 = 412.310 tỷ, thấp hơn T-2 (438.920) 6,06% và T-7 (437.310) 5,72%. Mức giảm −26.610 tỷ gấp khoảng 4 lần ngưỡng cảnh báo ±1,5%/ngày.</p></div>
  <div class="iosec"><h5>Kết quả kiểm tra 9 feature</h5><div style="overflow-x:auto"><table class="fchk"><thead><tr><th>Feature</th><th>T-1</th><th>T-2</th><th>T-7</th><th>Biến động</th><th>Trạng thái</th></tr></thead><tbody>${FEATS.map(featRow).join("")}</tbody></table></div>
    <p class="note" style="margin:6px 0 0">Kiểm tra chéo: giải ngân (2.330) − thu nợ (28.940) = −26.610 tỷ, khớp đúng mức giảm dư nợ.</p></div>
  <div class="iosec"><h5>Phân rã mức giảm −26.610 tỷ</h5><div class="cols" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
    <div>${tbl(BREAK.seg,"Phân khúc")}</div><div>${tbl(BREAK.br,"Chi nhánh")}</div><div>${tbl(BREAK.cus,"Khách hàng")}</div></div></div>
  <div class="iosec"><h5>Chẩn đoán của agent</h5><div class="cols">
    <div class="sig"><h6>🛠 Tín hiệu lỗi hệ thống / dữ liệu</h6><ul>${SIG_TECH.map(x=>`<li>${x}</li>`).join("")}</ul></div>
    <div class="sig"><h6>💼 Tín hiệu chiến lược kinh doanh / gian lận</h6><ul>${SIG_BIZ.map(x=>`<li>${x}</li>`).join("")}</ul></div></div>
    <p style="margin:10px 0 0;font-size:13px"><b>Kết luận sơ bộ:</b> có tín hiệu từ cả hai phía, chưa đủ cơ sở kết luận. Agent gửi song song 2 phiếu thay vì chờ một bên kiểm tra xong.</p></div>
  <div class="iosec"><h5>Phiếu cảnh báo đã gửi</h5><div class="cols">${TK.map(t=>{const st=tkst(t);return `<div class="ticket ${o?"ok":""}"><div class="hd"><b>${tkId(t)} → ${t.team}</b><span class="status ${st[0]}">${st[1]}</span></div>
      <div class="note">${t.sub} · Mức: ${t.pri} · ${t.sla}</div><ul>${t.checks.map(c=>`<li>${c}</li>`).join("")}</ul></div>`;}).join("")}</div>
    <div class="qbox ${qu?"":"off"}" style="margin-top:12px">${qu?`🔒 <b>Feature <code>du_no_chot_ngay</code> đang bị cách ly.</b> Các hệ thống phía sau tạm dùng giá trị T-2 kèm cờ cảnh báo: ${DOWNSTREAM.join(" · ")}.`:`🔓 <b>Đã gỡ cách ly feature <code>du_no_chot_ngay</code>.</b> Các hệ thống phía sau dùng lại số liệu T-1.`}</div></div>
  <div class="iosec noprint"><h5>Mô phỏng phản hồi từ các bộ phận (dùng khi demo)</h5>
    <div style="display:flex;gap:8px;flex-wrap:wrap">${Object.entries(OUT).map(([k,v])=>`<button class="btn ${IO.outcome===k?"primary":""}" data-o="${k}">${v.btn}</button>`).join("")}${o?'<button class="btn" data-o="">↺ Về trạng thái chờ</button>':""}</div>
    ${o?`<div class="outcome"><p style="margin:0 0 6px"><b>Kết quả kiểm tra:</b> ${o.find}</p><b style="font-size:13px">Hành động tiếp theo</b><ul>${o.act.map(a=>`<li>${a}</li>`).join("")}</ul>
      <p class="note" style="margin:8px 0 0"><b>Agent học từ phản hồi:</b> ${o.learn}</p></div>`:'<p class="note" style="margin:8px 0 0">Chọn một kết quả để xem phiếu cảnh báo, trạng thái cách ly và vòng phản hồi thay đổi ra sao.</p>'}</div>`;
  $$("#ioArea [data-o]").forEach(b=>b.onclick=()=>{IO.outcome=b.dataset.o||null;renderIO();if(IO.outcome)toast(`<b>Phản hồi cập nhật:</b> ${OUT[IO.outcome].btn}`);});
}

/* ===================== KHỞI TẠO ===================== */
$$(".mod").forEach(m=>m.onclick=()=>{$$(".mod").forEach(x=>x.classList.toggle("on",x===m));$$(".module").forEach(s=>s.classList.toggle("on",s.id==="m-"+m.dataset.m));});
$$(".module").forEach(mod=>mod.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{
  mod.querySelectorAll(".tab").forEach(x=>x.classList.toggle("on",x===t));
  mod.querySelectorAll(".view").forEach(v=>v.classList.toggle("on",v.id===t.dataset.v));
  const b=t.querySelector(".badge");if(b&&(t.dataset.v==="oi2"||t.dataset.v==="io2"))b.classList.add("hidden");
}));
$("#speed").onchange=e=>S.speed=+e.target.value;
$("#oiRun").onclick=oiRun;$("#oiReset").onclick=oiReset;$("#oiHide").onchange=applyHide;
$("#ioRun").onclick=ioRun;$("#ioReset").onclick=ioReset;
$("#dateIn").onchange=()=>{setClock($("#oiClock"),$("#oiClock").dataset.t||"22:00");setClock($("#ioClock"),$("#ioClock").dataset.t||"03:30");if(OI.done&&!OI.sent)renderBrief();if(IO.done)renderIO();};
document.addEventListener("keydown",e=>{if(e.key==="Escape")$("#modal").classList.remove("on");});
oiReset();ioReset();
</script>
</body>
</html>
