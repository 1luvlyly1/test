      setClock($("#oiClock"),h.t);$("#oiFeed").prepend(feedItem(h));
      $("#oiCount").textContent=`(${i+1})`;setAg("oa","crawl","run",`${i+1} tiêu đề`);
      oiLog("crawl",`+1 ${SRC[h.s].n}: "${h.title.length>62?h.title.slice(0,62)+"…":h.title}"`);
