    await sleep(500);oiGuard(my);
    let c={noise:0,trap:0,dup:0,keep:0};
    for(const h of H){
      const el=$("#f-"+h.id);
      if(h.k==="noise"){c.noise++;el.classList.add("out");setSt(h,`<span class="chip">loại: ${h.why}</span>`);oiLog("filter",`Loại ${h.id}: ${h.why}`,"m");}
      else if(h.k==="trap"){c.trap++;el.classList.add("out");setSt(h,`<span class="chip trap">bẫy: ${h.why}</span>`);oiLog("filter",`Loại ${h.id} (bẫy): ${h.why}`,"w");}
      else if(h.k==="dup"){c.dup++;el.classList.add("out");setSt(h,`<span class="chip">trùng với ${h.of}</span>`);oiLog("filter",`Gộp ${h.id} vào ${h.of} (độ tương đồng 0,9x)`,"m");}
      else if(h.k==="routine"){c.keep++;setSt(h,'<span class="chip rt">kinh tế thường nhật (lưu bối cảnh)</span>');}
      else{c.keep++;setSt(h,'<span class="chip keep">giữ lại</span>');}
      applyHide();await sleep(60);oiGuard(my);
    }
    setAg("oa","filter","done",`Giữ ${c.keep} · loại ${c.noise+c.trap} · trùng ${c.dup}`);
    oiLog("filter",`Giữ ${c.keep}/${H.length} tin (${Math.round(c.keep/H.length*100)}%). Loại ${c.noise} tin nhiễu, ${c.trap} tin bẫy từ khóa/giật tít, gộp ${c.dup} tin trùng.`,"ok");

    // 3. Event
    setAg("oa","event","run");setClock($("#oiClock"),"06:00");
    oiLog("event","Gom cụm theo thực thể & chủ đề, so tần suất với mức nền 30 ngày…");await sleep(700);oiGuard(my);
    const war=H.filter(h=>h.c==="war"||(h.k==="dup"&&HM[h.of].c==="war"));
    const hours=["23","00","01","02","03","04","05"],cnt=hours.map(x=>war.filter(h=>h.t.startsWith(x)).length),mx=Math.max(...cnt);
    $("#oiBars").innerHTML=cnt.map((n,i)=>`<div style="height:${Math.max(3,n/mx*56)}px"><i>${n||""}</i><span>${hours[i]}h</span></div>`).join("");
    const uniq=H.filter(h=>h.c==="war").length;
    $("#oiEventText").innerHTML=`<b>${uniq} tin độc lập</b> (+2 tin trùng) từ nhiều nguồn trong khoảng 23:40–05:42; mức nền chủ đề "Trung Đông/Iran" ~1,3 tin/đêm → <b>gấp ~${Math.round(uniq/1.3)} lần</b>. Mốc chính: 00:48 Mỹ không kích mục tiêu quân sự tại Iran; 01:34 Iran đe dọa phong tỏa eo biển Hormuz.`;
    const others=Object.keys(CL).filter(k=>k!=="war").map(k=>[k,H.filter(h=>h.c===k).length]).sort((a,b)=>b[1]-a[1]);
    $("#oiClus").innerHTML=`<span class="note">Các cụm khác:</span>`+others.map(([k,n])=>`<span class="chip cl">${CL[k]} · ${n}</span>`).join("");
    $("#oiEvent").classList.add("on");
    for(const h of H.filter(h=>h.c)){ $(`#f-${h.id} .chips`).insertAdjacentHTML("beforeend",`<span class="chip ${h.c==="war"?"ev":"cl"}">${CL[h.c]}</span>`);await sleep(25); }
    oiLog("event",`PHÁT HIỆN cụm "Xung đột Mỹ – Iran": ${uniq} tin, gấp ~${Math.round(uniq/1.3)} lần mức nền.`,"w");
    oiLog("event",`Cụm "Tin đồn về ABC": 3 tin trong 6 giờ, tin sau lan rộng hơn tin trước. Đối tượng là chính ngân hàng → ưu tiên cao nhất.`,"e");
    oiLog("event",`Các cụm khác: ${others.map(([k,n])=>`${CL[k]} (${n})`).join(", ")}.`,"m");
    setAg("oa","event","done",`${Object.keys(CL).length} cụm · 1 sự kiện lớn`);

    // 4. Impact
    setAg("oa","impact","run");setClock($("#oiClock"),"06:08");
    oiLog("impact","Áp dụng bản đồ kênh truyền dẫn: thanh khoản & uy tín, tỷ giá, lãi suất, giá hàng hóa, tín dụng ngành, thương mại, tuân thủ, an ninh mạng, vận hành…");
    await sleep(400);
    for(const [i,x] of INS.entries()){
      oiLog("impact",`${x.id} ${x.short}: ${x.chain[0]} → … → ${x.chain[x.chain.length-1]}`);
      oiLog("impact",`   mảng: ${x.lines.map(c=>LN[c]).join(", ")} · nguồn: ${x.src.join(", ")}`,"m");
      setAg("oa","impact","run",`${i+1}/${INS.length} chủ đề`);await sleep(240);oiGuard(my);
    }
    setAg("oa","impact","done",`${INS.length} chủ đề tác động`);

    // 5. Score
    setAg("oa","score","run");setClock($("#oiClock"),"06:18");
    oiLog("score","Xếp hạng theo mức nghiêm trọng (cao → thấp), cùng mức thì theo điểm ưu tiên:");
