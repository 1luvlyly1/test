    }
    setAg("oa","crawl","done",`${H.length} tiêu đề / 10 nguồn`);oiLog("crawl",`Hoàn tất: ${H.length} tiêu đề.`,"ok");

    // 2. Filter
    setAg("oa","filter","run");setClock($("#oiClock"),"05:56");
