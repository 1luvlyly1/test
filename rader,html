<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Radar AI Agents</title>
<style>
:root{
  --bg:#f3f5f9; --panel:#ffffff; --panel2:#f8fafc; --ink:#0f1b2d; --muted:#5b6b82; --line:#e2e8f0;
  --accent:#0b5cab; --accent-soft:#e6f0fb;
  --red:#b71c1c; --red-soft:#fdecec; --orange:#d4570f; --orange-soft:#fdeee4; --amber:#a86500; --amber-soft:#fff4e0;
  --blue:#2a6fb0; --blue-soft:#e8f1fb; --green:#1b7f4b; --green-soft:#e6f6ee; --grey-soft:#eef1f5;
  --vio:#6b3fb5; --vio-soft:#f1ebfb;
  --term:#0d1626; --term-ink:#cfe3ff; --shadow:0 1px 2px rgba(15,27,45,.06),0 4px 14px rgba(15,27,45,.05);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0b1220; --panel:#121b2c; --panel2:#0f1726; --ink:#e6edf7; --muted:#93a3ba; --line:#22304a;
    --accent:#5aa2ef; --accent-soft:#16294a;
    --red:#ff6b6b; --red-soft:#3a1717; --orange:#ff9a5c; --orange-soft:#3a2312; --amber:#f2b04b; --amber-soft:#3a2a10;
    --blue:#6aa8e8; --blue-soft:#132a45; --green:#4cc98a; --green-soft:#11301f; --grey-soft:#1a2436;
    --vio:#b597f0; --vio-soft:#231a38;
    --term:#070d18; --term-ink:#bcd6ff; --shadow:none;
  }
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
button{font:inherit;cursor:pointer}
code{font-family:ui-monospace,Menlo,Consolas,monospace}
.wrap{max-width:1440px;margin:0 auto;padding:16px}
header.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:12px}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:40px;height:40px;border-radius:10px;background:var(--ink);display:grid;place-items:center;color:var(--bg);font-weight:700}
.brand h1{font-size:18px;margin:0}
.brand p{margin:0;color:var(--muted);font-size:12.5px}
.controls,.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.toolbar{margin-bottom:10px}
.toolbar .grow{flex:1}
.clock{font-variant-numeric:tabular-nums;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-weight:600}
.clock small{color:var(--muted);font-weight:400}
.btn{border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:8px;padding:7px 12px}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn:disabled{opacity:.5;cursor:not-allowed}
select.btn,input.btn{padding:6px 8px}
.banner{background:var(--amber-soft);color:var(--amber);border-radius:8px;padding:6px 12px;font-size:12.5px;margin-bottom:12px}
.mods{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.mod{flex:1;min-width:260px;text-align:left;border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:10px 14px;color:var(--ink);display:flex;gap:12px;align-items:center}
.mod .ic{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;color:#fff;font-weight:700;font-size:13px;flex:0 0 34px}
.mod[data-m="oi"] .ic{background:#0b5cab}.mod[data-m="io"] .ic{background:#6b3fb5}
.mod b{display:block;font-size:15px}.mod small{color:var(--muted)}
.mod.on[data-m="oi"]{border-color:#0b5cab;box-shadow:inset 0 0 0 1px #0b5cab}
.mod.on[data-m="io"]{border-color:#6b3fb5;box-shadow:inset 0 0 0 1px #6b3fb5}
.module{display:none}.module.on{display:block}
#m-io{--accent:var(--vio);--accent-soft:var(--vio-soft)}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:14px;overflow-x:auto}
.tab{border:0;background:none;color:var(--muted);padding:10px 14px;border-bottom:2px solid transparent;white-space:nowrap}
.tab.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.badge{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:var(--red);color:#fff;font-size:11px;line-height:18px;text-align:center;margin-left:6px}
.view{display:none}.view.on{display:block}
.grid3{display:grid;grid-template-columns:270px minmax(0,1fr) 360px;gap:14px}
@media (max-width:1100px){.grid3{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}
.card h3,.sec-title{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0;padding:12px 14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:8px}
.sec-title{padding:14px 18px 10px;border-bottom:0}
.pad{padding:12px 14px}
.note{color:var(--muted);font-size:12px}
.empty{color:var(--muted);text-align:center;padding:40px 16px}
.hidden{display:none!important}
/* agents */
.agent{display:flex;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line);transition:background .2s}
.agent:last-child{border-bottom:0}
.agent .dot{width:28px;height:28px;flex:0 0 28px;border-radius:50%;display:grid;place-items:center;background:var(--grey-soft);color:var(--muted);font-size:12px;font-weight:700}
.agent.run{background:var(--accent-soft)}
.agent.run .dot{background:var(--accent);color:#fff;animation:pulse 1s infinite}
.agent.done .dot{background:var(--green);color:#fff}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
.agent b{display:block;font-size:13.5px}
.agent span{color:var(--muted);font-size:12px}
.agent .met{color:var(--accent);font-weight:600;font-size:12px}
/* feed */
.feed{max-height:640px;overflow:auto}
.item{display:grid;grid-template-columns:48px minmax(0,1fr);gap:10px;padding:8px 14px;border-bottom:1px solid var(--line);animation:fadein .3s}
@keyframes fadein{from{opacity:0;transform:translateY(-4px)}to{opacity:1}}
.item .t{color:var(--muted);font-variant-numeric:tabular-nums;font-size:12.5px;padding-top:1px}
.item .ttl{font-weight:500}
.item.out .ttl{color:var(--muted);text-decoration:line-through;text-decoration-color:rgba(127,127,127,.5)}
.item.hide{display:none}
.chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}
.chip{font-size:11px;border-radius:5px;padding:1px 6px;background:var(--grey-soft);color:var(--muted)}
.chip.src{background:transparent;border:1px solid var(--line)}
.chip.ev{background:var(--red-soft);color:var(--red);font-weight:600}
.chip.cl{background:var(--orange-soft);color:var(--orange);font-weight:600}
.chip.keep{background:var(--blue-soft);color:var(--blue)}
.chip.rt{background:var(--green-soft);color:var(--green)}
.chip.trap{background:var(--amber-soft);color:var(--amber)}
/* log */
.term{background:var(--term);color:var(--term-ink);font:12px/1.55 ui-monospace,Menlo,Consolas,monospace;height:640px;overflow:auto;padding:10px 12px;border-radius:0 0 12px 12px}
.term div{white-space:pre-wrap;word-break:break-word}
.term .a{color:#7fd1ff}.term .w{color:#ffc46b}.term .e{color:#ff8a8a}.term .ok{color:#7ee2a8}.term .m{color:#6f86a8}
/* event card */
.event{border:1px solid var(--red);background:var(--red-soft);border-radius:12px;padding:12px 14px;margin-bottom:14px;display:none}
.event.on{display:block;animation:fadein .4s}
.event h4{margin:0 0 4px;color:var(--red);font-size:15px}
.event .row{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end}
.event p{margin:0;font-size:13px}
.bars{display:flex;gap:4px;align-items:flex-end;height:60px}
.bars div{width:22px;background:var(--red);border-radius:3px 3px 0 0;position:relative}
.bars div span{position:absolute;bottom:-17px;left:50%;transform:translateX(-50%);font-size:10px;color:var(--muted)}
.bars div i{position:absolute;top:-15px;left:50%;transform:translateX(-50%);font-size:10px;font-style:normal;color:var(--red)}
.clus{margin-top:22px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:12.5px}
details.arch{margin-top:14px}
details.arch summary{cursor:pointer;color:var(--accent);font-weight:600}
details.arch ol{margin:8px 0 0;padding-left:18px;color:var(--muted)}
/* brief */
.brief-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:flex-start;padding:16px 18px;border-bottom:1px solid var(--line)}
.brief-head h2{margin:0;font-size:19px}
.brief-head .meta{color:var(--muted);font-size:12.5px}
.alert{border-radius:8px;padding:6px 12px;font-weight:700;font-size:13px;background:var(--red-soft);color:var(--red)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;padding:14px 18px}
.kpi{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.kpi b{font-size:22px;display:block;font-variant-numeric:tabular-nums}
.kpi span{color:var(--muted);font-size:12px}
.summary{padding:0 18px 6px}
.summary p{margin:0 0 8px}
.summary ol{margin:0 0 8px;padding-left:20px}
.mx{overflow-x:auto;padding:0 18px 12px}
table{border-collapse:collapse;width:100%}
.mx th,.mx td{border-bottom:1px solid var(--line);padding:6px 8px;font-size:12.5px;text-align:center}
.mx th.l,.mx td.l{text-align:left}
.mx th{color:var(--muted);font-weight:600;font-size:11.5px;vertical-align:bottom}
.mx tr[data-go]{cursor:pointer}.mx tbody tr:hover{background:var(--panel2)}
.cell{display:inline-block;width:16px;height:16px;border-radius:4px}
.s4{background:var(--red)}.s3{background:var(--orange)}.s2{background:var(--amber)}.s1{background:var(--blue)}.op{background:var(--green)}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);padding:0 18px 12px}
.legend .cell{width:12px;height:12px;vertical-align:-2px;margin-right:4px}
.ins{border:1px solid var(--line);border-left:5px solid var(--blue);border-radius:10px;padding:12px 14px;margin:0 18px 12px;background:var(--panel);scroll-margin-top:12px}
.ins.sev4{border-left-color:var(--red);background:linear-gradient(90deg,var(--red-soft),var(--panel) 40%)}
.ins.sev3{border-left-color:var(--orange)}.ins.sev2{border-left-color:var(--amber)}.ins.opp{border-left-color:var(--green)}
.ins-top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.ins h4{margin:0;font-size:15px}
.rank{display:inline-grid;place-items:center;min-width:26px;height:22px;border-radius:6px;background:var(--ink);color:var(--bg);font-size:12px;font-weight:700;margin-right:6px;padding:0 5px}
.tag{font-size:11.5px;font-weight:600;border-radius:5px;padding:1px 7px;white-space:nowrap}
.tag.s4{background:var(--red);color:#fff}.tag.s3{background:var(--orange-soft);color:var(--orange)}.tag.s2{background:var(--amber-soft);color:var(--amber)}.tag.s1{background:var(--blue-soft);color:var(--blue)}.tag.op{background:var(--green-soft);color:var(--green)}
.chain{margin:8px 0;font-size:13px}
.chain .arr{color:var(--muted);margin:0 4px}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:6px 16px;font-size:12.5px;margin:6px 0}
.facts div span{color:var(--muted)}
.score{font-variant-numeric:tabular-nums;font-weight:700}
.nl{list-style:none;margin:8px 0 0;padding:0;border-top:1px dashed var(--line)}
.nl li{padding:5px 0;border-bottom:1px dashed var(--line);font-size:13px}
.nl label{display:flex;gap:8px;align-items:baseline;cursor:pointer}
.nl .nt{color:var(--muted);font-variant-numeric:tabular-nums;font-size:12px;flex:0 0 38px}
.ins details{font-size:12.5px;margin-top:6px}
.ins details summary{cursor:pointer;color:var(--accent)}
.ins details ul{margin:6px 0 0;padding-left:18px}
.decide{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}
.decide .btn{padding:5px 10px;font-size:13px}
.decide .btn.sel-dl{background:var(--green);border-color:var(--green);color:#fff}
.decide .btn.sel-watch{background:var(--amber);border-color:var(--amber);color:#fff}
.decide .btn.sel-skip{background:var(--muted);border-color:var(--muted);color:#fff}
.decide input{flex:1;min-width:180px;border:1px solid var(--line);background:var(--panel2);color:var(--ink);border-radius:8px;padding:5px 10px;font:inherit;font-size:13px}
.sticky{position:sticky;bottom:0;background:var(--panel);border-top:1px solid var(--line);padding:12px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;border-radius:0 0 12px 12px;z-index:2}
/* downloads */
.deep{border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:14px;box-shadow:var(--shadow)}
.deep .hd{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center}
.deep .hd h4{margin:0;font-size:15px}
.deep .bd{padding:12px 16px}
.steps div{font-size:13px;padding:3px 0;color:var(--muted)}
.steps div.ok{color:var(--ink)}
.steps div.ok::before{content:"✓ ";color:var(--green);font-weight:700}
.steps div.run::before{content:"◌ ";color:var(--accent)}
.files{margin-top:10px;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.file{display:flex;gap:10px;align-items:center;padding:7px 10px;border-bottom:1px solid var(--line);font-size:13px}
.file:last-child{border-bottom:0}
.file code{flex:1;font-size:12px;word-break:break-all}
.file .sz{color:var(--muted);font-size:12px;white-space:nowrap}
.file .btn{padding:3px 9px;font-size:12px}
.dlbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.modal{position:fixed;inset:0;background:rgba(5,10,20,.55);display:none;align-items:center;justify-content:center;padding:16px;z-index:20}
.modal.on{display:flex}
.mbox{background:var(--panel);border-radius:12px;width:min(860px,100%);max-height:88vh;display:flex;flex-direction:column;border:1px solid var(--line)}
.mhd{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid var(--line)}
.mhd b{font-size:13px;word-break:break-all}
.mbox pre{margin:0;padding:14px;overflow:auto;font:12.5px/1.55 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;color:var(--ink)}
/* inside-out */
.chart{width:100%;height:auto;display:block}
.chart .gl{stroke:var(--line)} .chart .ax{fill:var(--muted);font-size:10px}
.chart .band{fill:var(--green);opacity:.13}
.chart .ln{fill:none;stroke:var(--vio);stroke-width:2}
.chart .ln2{fill:none;stroke:var(--red);stroke-width:2;stroke-dasharray:4 3}
.chart .pt{fill:var(--vio)} .chart .bad{fill:var(--red)}
.chart .lbl{fill:var(--red);font-size:11px;font-weight:700} .chart .bl{fill:var(--green);font-size:10px}
.fchk{width:100%}
.fchk td,.fchk th{border-bottom:1px solid var(--line);padding:6px 8px;font-size:12.5px;text-align:right;white-space:nowrap}
.fchk td:first-child,.fchk th:first-child{text-align:left;white-space:normal}
.fchk th{color:var(--muted);font-weight:600;font-size:11.5px}
.fchk code{font-size:11px;color:var(--muted)}
.fchk tr{animation:fadein .3s}
.st-ok{color:var(--green)} .st-warn{color:var(--amber);font-weight:600} .st-alert{color:var(--red);font-weight:700}
.iosec{padding:14px 18px;border-bottom:1px solid var(--line)}
.iosec:last-child{border-bottom:0}
.iosec h5{margin:0 0 8px;font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.iosec ul{margin:0;padding-left:18px;font-size:13px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:800px){.cols{grid-template-columns:1fr}}
.sig{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--panel2)}
.sig h6{margin:0 0 6px;font-size:13px}
.ticket{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--panel)}
.ticket .hd{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.ticket ul{list-style:none;padding:0;margin:6px 0 0}
.ticket li{font-size:13px;padding:2px 0}
.ticket li::before{content:"☐ ";color:var(--muted)}
.ticket.ok li::before{content:"☑ ";color:var(--green)}
.status{font-size:11.5px;font-weight:600;border-radius:5px;padding:1px 7px;background:var(--blue-soft);color:var(--blue);white-space:nowrap}
.status.done{background:var(--green-soft);color:var(--green)} .status.esc{background:var(--red-soft);color:var(--red)} .status.closed{background:var(--grey-soft);color:var(--muted)}
.qbox{border:1px solid var(--amber);background:var(--amber-soft);border-radius:10px;padding:10px 12px;font-size:13px}
.qbox.off{border-color:var(--green);background:var(--green-soft)}
.outcome{margin-top:12px;padding:12px 14px;border-radius:10px;border:1px dashed var(--vio);background:var(--vio-soft)}
.toast{position:fixed;right:16px;bottom:16px;max-width:380px;background:var(--ink);color:var(--bg);padding:12px 14px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.25);transform:translateY(160%);transition:transform .3s;z-index:30;font-size:13px}
.toast.on{transform:none}
@media print{
  header.top,.mods,.banner,.toolbar,.tabs,.decide,.sticky,.toast,.modal,.noprint{display:none!important}
  body{background:#fff} .card,.ins{box-shadow:none;break-inside:avoid}
}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">
      <div class="logo">AI</div>
      <div>
        <h1>Radar AI Agents · Ngân hàng ABC</h1>
        <p>Hai module độc lập: theo dõi tin tức bên ngoài (Outside-In) và giám sát dữ liệu nội bộ (Inside-Out)</p>
      </div>
    </div>
    <div class="controls">
      <label class="note">Ngày giả định (đêm crawl / T-1) <input type="date" id="dateIn" class="btn"></label>
      <select id="speed" class="btn" title="Tốc độ mô phỏng">
        <option value="1">Tốc độ 1×</option><option value="2" selected>2×</option><option value="4">4×</option><option value="10">10×</option>
      </select>
    </div>
  </header>
  <div class="banner">Prototype · Tên báo, tiêu đề, nội dung bài, khách hàng và số liệu đều là <b>dữ liệu giả lập</b>, viết sẵn theo kịch bản để trình diễn luồng nghiệp vụ. Chạy hoàn toàn offline.</div>

  <div class="mods">
    <button class="mod on" data-m="oi"><span class="ic">OI</span><span><b>Outside-In Radar</b><small>Crawl tiêu đề báo hàng đêm → tác động tới ngân hàng → Line Manager duyệt tải tin</small></span></button>
    <button class="mod" data-m="io"><span class="ic">IO</span><span><b>Inside-Out Monitor</b><small>Giám sát feature dữ liệu nội bộ sau ETL → cảnh báo Kỹ thuật & Kinh doanh</small></span></button>
  </div>

  <!-- ===================== MODULE OUTSIDE-IN ===================== -->
  <section class="module on" id="m-oi">
    <div class="toolbar">
      <div class="clock" id="oiClock"></div>
      <button class="btn primary" id="oiRun">▶ Chạy phiên crawl đêm</button>
      <button class="btn" id="oiReset">↺ Đặt lại</button>
      <span class="grow"></span>
      <span class="note">Line Manager: Trưởng phòng Phân tích Kinh tế & Thị trường</span>
    </div>
    <nav class="tabs">
      <button class="tab on" data-v="oi1">1 · Pipeline đêm (22:00 → 06:30)</button>
      <button class="tab" data-v="oi2">2 · Bản tin sáng: xếp theo mức nghiêm trọng<span class="badge hidden" id="oiB2">1</span></button>
      <button class="tab" data-v="oi3">3 · Tin đã duyệt (.md)<span class="badge hidden" id="oiB3">0</span></button>
    </nav>

    <section class="view on" id="oi1">
      <div class="grid3">
        <div>
          <div class="card"><h3>Agents</h3><div id="oiAgents"></div></div>
          <details class="arch card pad">
            <summary>Kiến trúc & cách làm bản thật</summary>
            <ol>
